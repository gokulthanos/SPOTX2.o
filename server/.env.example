# ─────────────────────────────────────────────────
# SpotX 4.0 — Environment Variables
# Copy to .env and configure for production
# ─────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=5000

# Database (PostgreSQL — for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/spotx

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-production-jwt-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=your-production-refresh-secret-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Provider (CONSOLE, MSG91, FAST2SMS, TWILIO)
SMS_PROVIDER=CONSOLE
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=

# Firebase Cloud Messaging
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Database path (SQLite fallback)
DB_PATH=./data/spotx.db

# Rate Limiting
OTP_MAX_REQUESTS=3
OTP_WINDOW_MINUTES=10
